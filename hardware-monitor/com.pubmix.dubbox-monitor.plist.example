<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.pubmix.dubbox-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/PATH/TO/PYTHON</string>
		<string>/ABSOLUTE/PATH/TO/studio/hardware-monitor/record.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/ABSOLUTE/PATH/TO/studio/monitor-data/service.log</string>
	<key>StandardOutPath</key>
	<string>/ABSOLUTE/PATH/TO/studio/monitor-data/service.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>WorkingDirectory</key>
	<string>/ABSOLUTE/PATH/TO/studio</string>
</dict>
</plist>
